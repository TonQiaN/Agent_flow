FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && npm install --global --prefix /opt/dsh @deepseek-ai/dsh@0.1.1-rc.2
RUN cd /opt/dsh/lib/node_modules/@deepseek-ai/dsh && npm pkg set 'dependencies.@deepseek-ai/cordis=4.0.1' 'overrides.@deepseek-ai/cordis=4.0.1' && npm install --omit=dev
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap ca-certificates git jq ripgrep socat python3 && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/dsh/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js /usr/local/bin/dsh && chmod +x /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js
ENTRYPOINT []
